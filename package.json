{
  "name": "ae-mcp-server",
  "version": "0.1.0",
  "description": "MCP server that lets AI assistants control Adobe After Effects via ExtendScript",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ae-mcp-server": "dist/index.js"
  },
  "files": [
